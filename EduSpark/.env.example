# ---------------------------------------------------------------------------
# Modèle de configuration EduSpark.
# Copier ce fichier en .env (même dossier, à côté de manage.py) :
#     Copy-Item .env.example .env
# .env contient les secrets et n'est JAMAIS versionné (voir .gitignore).
# ---------------------------------------------------------------------------

# --- Sécurité --------------------------------------------------------------
# Obligatoire : aucune clé n'est écrite dans settings.py.
# Générer une clé unique pour chaque environnement :
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# Coller ensuite la clé (entre guillemets) dans la ligne suivante.
DJANGO_SECRET_KEY=

# Mettre False (ou supprimer la ligne) en production : jamais de traceback exposée.
DJANGO_DEBUG=True

# Hôtes autorisés, séparés par des virgules. Vide = aucun hôte accepté.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# --- Internationalisation --------------------------------------------------
DJANGO_LANGUAGE_CODE=en-us
DJANGO_TIME_ZONE=UTC

# --- Base de données (PostgreSQL) ------------------------------------------
# Le projet tourne sur PostgreSQL (driver psycopg 3, cf. requirements.txt).
# La base doit exister avant les migrations (voir README, étape 3) :
#   psql -U postgres -c "CREATE DATABASE eduspark ENCODING 'UTF8';"
# En local le plus simple est d'utiliser le superutilisateur postgres :
# renseigner son mot de passe ci-dessous (ce fichier n'est jamais versionné).
DJANGO_DB_NAME=eduspark
DJANGO_DB_USER=postgres
DJANGO_DB_PASSWORD=
DJANGO_DB_HOST=localhost
DJANGO_DB_PORT=5432

# Variante recommandée hors développement local : un rôle dédié, propriétaire
# de la base et titulaire du droit CREATEDB (nécessaire à manage.py test).
#   CREATE ROLE eduspark WITH LOGIN PASSWORD '...' CREATEDB;
#   CREATE DATABASE eduspark OWNER eduspark ENCODING 'UTF8';
# puis DJANGO_DB_USER=eduspark et DJANGO_DB_PASSWORD=<mot de passe du rôle>.

# --- E-mails ---------------------------------------------------------------
# Console en développement : les e-mails (réinitialisation de mot de passe)
# s'affichent dans la sortie du serveur.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_DEFAULT_FROM_EMAIL=EduSpark <no-reply@eduspark.local>

# Configuration SMTP en production (décommenter et renseigner) :
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# DJANGO_EMAIL_HOST=smtp.example.com
# DJANGO_EMAIL_PORT=587
# DJANGO_EMAIL_HOST_USER=no-reply@example.com
# DJANGO_EMAIL_HOST_PASSWORD=
# DJANGO_EMAIL_USE_TLS=True
